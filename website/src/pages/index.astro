---
import Base from "../layouts/Base.astro";
import data from "../data/projects.json";
const total = data.reduce((n, c) => n + c.projects.length, 0);
const updated = "September 3, 2026";
const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const pslug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const site = "https://aiagentplatforms.dev";

const catMeta = {
  "AI coworkers and teammates": { slug: "ai-coworkers", color: "var(--c1)", blurb: "Persistent agents you delegate real work to." },
  "Agent builders and frameworks": { slug: "agent-builders", color: "var(--c2)", blurb: "Tools developers use to build custom agents." },
  "Workflow automation platforms": { slug: "workflow-automation", color: "var(--c3)", blurb: "Run repeatable processes with AI steps." },
  "Browser agents": { slug: "browser-agents", color: "var(--c4)", blurb: "Agents that operate web browsers." },
  "Coding agents": { slug: "coding-agents", color: "var(--c5)", blurb: "Agents that read, edit, and ship code." },
};

const title = `AI Agent Platforms: ${total} open-source AI coworkers, agent builders, and automation tools`;
const description = `A maintained directory of ${total} AI agent platforms: AI coworkers and teammates, agent builders and frameworks, workflow automation platforms, browser agents, and coding agents, with license and hosting details for each.`;
const ld = [
  { "@context": "https://schema.org", "@type": "WebSite", name: "AI Agent Platforms", url: site, description },
  {
    "@context": "https://schema.org", "@type": "ItemList", name: "AI agent platforms directory",
    description, url: site, numberOfItems: total,
    itemListElement: data.flatMap((c) => c.projects).map((p, i) => ({
      "@type": "ListItem", position: i + 1, name: p.name, url: `${site}/platforms/${pslug(p.name)}/`,
    })),
  },
];
---

<Base title={title} description={description} path="/" ld={ld} wide={true}>
  <section class="hero">
    <h1>The open-source AI agent platform landscape</h1>
    <p class="lead">
      A maintained directory of {total} AI agent platforms: AI coworkers you delegate work to, the
      frameworks developers build agents with, workflow automation, browser agents, and coding agents.
      Every entry lists its exact license and hosting model.
    </p>
    <p class="muted small">Updated {updated} · <a href="/how-to-choose/">How to choose</a> · <a href="/faq/">FAQ</a></p>
  </section>

  <nav class="cats" aria-label="Categories">
    {Object.entries(catMeta).map(([name, m]) => {
      const count = data.find((c) => c.name === name)?.projects.length ?? 0;
      return (
        <a class="cat-card" href={`/categories/${m.slug}/`} style={`--cat:${m.color}`}>
          <span class="cc-head">
            <span class="cc-name">{name}</span>
            <span class="cc-count">{count}</span>
          </span>
          <span class="cc-blurb">{m.blurb}</span>
        </a>
      );
    })}
  </nav>

  <figure class="map">
    <img src="/market-map.svg" width="1440" height="1456"
      alt={`Market map of ${total} AI agent platforms grouped into five categories`} />
    <figcaption class="muted small">The {total} platforms, grouped by main use. Full detail below.</figcaption>
  </figure>

  {data.map((c) => (
    <section class="cat-section" id={slug(c.name)}>
      <div class="sec-head">
        <span class="dot" style={`background:${catMeta[c.name]?.color}`}></span>
        <h2><a href={`/categories/${catMeta[c.name]?.slug}/`}>{c.name}</a></h2>
        <span class="muted small">{c.projects.length}</span>
      </div>
      <p class="catdesc muted">{c.description}</p>
      <div class="grid">
        {c.projects.map((p) => (
          <a class="card" href={`/platforms/${pslug(p.name)}/`}>
            <div class="card-top">
              <img src={`https://github.com/${p.org}.png?size=48`} alt="" loading="lazy" decoding="async" width="24" height="24" />
              <span class="card-name">{p.name}</span>
            </div>
            <p class="card-desc">{p.description}</p>
            <div class="badges">
              <span class="badge">{p.license}</span>
              <span class="badge">{p.hosting}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="cat-section" id="comparison">
    <h2>Full comparison</h2>
    <p class="catdesc muted">Every listed platform with its category, license, and hosting model.</p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>Platform</th><th>Category</th><th>License</th><th>Hosting</th></tr>
        </thead>
        <tbody>
          {data.flatMap((c) => c.projects.map((p) => (
            <tr>
              <td><a href={`/platforms/${pslug(p.name)}/`}>{p.name}</a></td>
              <td class="muted">{c.name}</td>
              <td class="muted">{p.license}</td>
              <td class="muted">{p.hosting}</td>
            </tr>
          )))}
        </tbody>
      </table>
    </div>
  </section>

  <style>
    .small { font-size: 0.88rem; }
    .hero { padding: 40px 0 8px; max-width: 760px; }
    .hero h1 { font-size: 2.4rem; }

    .cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 28px 0 8px; align-items: stretch; }
    .cat-card {
      display: flex; flex-direction: column; gap: 6px; padding: 14px 16px 15px;
      border: 1px solid var(--line); border-left: 3px solid var(--cat); border-radius: 12px;
      background: var(--surface); box-shadow: var(--shadow); color: var(--ink);
    }
    .cat-card:hover { text-decoration: none; border-color: var(--accent); border-left-color: var(--cat); transform: translateY(-1px); transition: .12s; }
    .cc-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .cc-name { font-weight: 600; font-size: 0.95rem; }
    .cc-count { color: var(--muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
    .cc-blurb { color: var(--ink-2); font-size: 0.85rem; }
    .dot { width: 10px; height: 10px; border-radius: 3px; flex: none; }

    .map { margin: 28px 0 8px; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--surface); box-shadow: var(--shadow); }
    .map img { display: block; width: 100%; height: auto; }
    .map figcaption { padding: 10px 16px; border-top: 1px solid var(--line-2); }

    .cat-section { margin-top: 48px; scroll-margin-top: 72px; }
    .sec-head { display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line); padding-bottom: 8px; }
    .sec-head h2 { margin: 0; font-size: 1.3rem; }
    .sec-head .muted { margin-left: auto; font-variant-numeric: tabular-nums; }
    .sec-head h2 a { color: var(--ink); }
    .sec-head h2 a:hover { color: var(--accent); }
    .catdesc { margin: 12px 0 0; max-width: 70ch; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; margin-top: 18px; }
    .card { border: 1px solid var(--line); border-radius: 12px; padding: 15px 16px; background: var(--surface); box-shadow: var(--shadow); color: var(--ink); display: flex; flex-direction: column; gap: 9px; }
    .card:hover { text-decoration: none; border-color: var(--accent); transform: translateY(-1px); transition: .12s; }
    .card-top { display: flex; align-items: center; gap: 10px; }
    .card-top img { border-radius: 6px; background: #fff; }
    .card-name { font-weight: 600; font-size: 1rem; }
    .card-desc { margin: 0; font-size: 0.9rem; color: var(--ink-2); flex: 1; }

    .table-scroll { overflow-x: auto; margin-top: 16px; }
    table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
    th, td { text-align: left; border-bottom: 1px solid var(--line-2); padding: 9px 12px 9px 0; vertical-align: top; white-space: nowrap; }
    td.muted { white-space: normal; }
    th { color: var(--muted); font-weight: 600; }

    @media (max-width: 600px) { .hero h1 { font-size: 1.9rem; } }
  </style>
</Base>
